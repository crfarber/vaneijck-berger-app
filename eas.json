{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.13.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "internal" }
    },
    "internal": {
      "extends": "base",
      "distribution": "internal",
      "channel": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "internal" },
      "android": { "buildType": "apk" }
    },
    "acceptance": {
      "extends": "base",
      "distribution": "internal",
      "channel": "acceptance",
      "environment": "preview",
      "env": { "APP_VARIANT": "acceptance" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {}
  }
}
