# Reference of all environment variables. Copy to `.env.local` for local use.
# For builds these values come from EAS environment variables per profile (internal,
# acceptance, production). Never commit real values, secrets or tokens.
#
# EXPO_PUBLIC_* is baked into the app at build time and is therefore NOT secret.
# Anything that must stay secret belongs in the backend, not in the app.

# Metro bundler port for local dev (`pnpm start`, `pnpm ios`, `pnpm android`).
RCT_METRO_PORT=1818

# Base URL of the Salvage API, without a trailing slash.
EXPO_PUBLIC_API_BASE_URL=

# Environment name for logging and display: internal | acceptance | production
EXPO_PUBLIC_ENVIRONMENT=internal

# Azure AD (internal users). Set all three or none.
EXPO_PUBLIC_AZURE_AD_TENANT_ID=
EXPO_PUBLIC_AZURE_AD_CLIENT_ID=
EXPO_PUBLIC_AZURE_AD_REDIRECT_URL=

# OAuth client_id for external users (SMS login via /connect/token). Required.
# Same public value as `clientId` in the old app's src/config/openid.config.ts.
EXPO_PUBLIC_EXTERNAL_CLIENT_ID=

# Google Places (address search in forms). Restrict the key in the Google console to this
# app (bundle identifier and package name).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# EAS project id, used to obtain an Expo push token (slice 9). Not a secret. Optional locally:
# app.config.ts already has the linked project id as fallback. Set this to override.
EXPO_PUBLIC_EAS_PROJECT_ID=
