{
  "name": "vaneijck-berger-app",
  "productName": "Van Eijck Berger App",
  "version": "2.0.0",
  "private": true,
  "main": "index.js",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client --port 1818",
    "android": "expo run:android --port 1818",
    "ios": "expo run:ios --port 1818",
    "prebuild": "expo prebuild --clean",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "ci": "pnpm run check && pnpm run test:coverage",
    "doctor": "pnpm dlx expo-doctor",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.4.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "24.1.1",
    "@react-native-firebase/messaging": "24.1.1",
    "@tanstack/react-query": "^5.103.2",
    "base64-js": "^1.5.1",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "^57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "^57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-app-auth": "8.4.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-signature-ink": "^1.1.3",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
